# Copy to .env and fill in. Never commit .env.
# APP_MODE: mock (no keys needed) | live (Meta Model API) ; privacy mode is a runtime toggle
APP_MODE=mock
MODEL_API_KEY=
BASETEN_API_KEY=
# Alternative partner host for Muse Spark Open (OpenAI-compatible endpoint on Modal)
MODAL_SPARK_URL=
MODAL_SPARK_KEY=
# Optional privacy tier: Muse Glimmer (open weights) on your own OpenAI-compatible server
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_KEY=
# Optional: SAM 3.1 open weights on Modal
MODAL_SAM_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Required to start live/privacy sessions from the UI (single passcode, no accounts)
LIVE_PASSCODE=

# Family relay over WhatsApp Cloud API (optional; without these a simulated relative replies)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
