{
  "name": "ventriloquist-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \"*.{ts,js,json,md}\"",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "build:demo": "node scripts/prepare-demo.mjs && tsc --noEmit && VITE_DEMO=browser vite build --base \"${DEMO_BASE:-/}\" && cp dist/index.html dist/404.html",
    "dev:demo": "node scripts/prepare-demo.mjs && VITE_DEMO=browser vite --host"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "uqr": "0.1.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.23",
    "globals": "16.4.0",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
